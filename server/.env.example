# Server Port
PORT=4555

# MongoDB Connection String URI
MONGODB_URI=mongodb://localhost:27017/CRM-Apollo

# JWT Signature Secret Key
JWT_SECRET=MISAIKILITOSECRET

# Gemini API Keys (Multi-key rotation)
GEMINI_API_KEY=your_primary_gemini_api_key
GEMINI_API_KEY_1=your_gemini_api_key_1
GEMINI_API_KEY_2=your_gemini_api_key_2
GEMINI_API_KEY_3=your_gemini_api_key_3
GEMINI_API_KEY_4=your_gemini_api_key_4

# Optional: Vertex AI region used only for the Service Account auth path (defaults to us-central1)
GEMINI_LOCATION=us-central1


GEMINI_CREDENTIALS_PATH=

GOOGLE_APPLICATION_CREDENTIALS=
